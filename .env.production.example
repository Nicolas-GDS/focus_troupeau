# Production (chapitre 6.5) — copier en .env.production sur le serveur, remplir, ne jamais versionner.
APP_NAME="Focus Troupeau"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=https://focus-troupeau.example.fr
APP_LOCALE=fr
APP_TIMEZONE=Europe/Paris
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Proxy TLS de l'hébergeur (adresses séparées par des virgules, ou * derrière un proxy unique)
TRUSTED_PROXIES=*

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=focustroupeau
DB_USERNAME=focustroupeau
DB_PASSWORD=
DB_SSLMODE=require

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
CACHE_PREFIX=focustroupeau
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true

SECURITE_CSP=enforce
SECURITE_HSTS_SECONDES=31536000
SECURITE_CSP_SOURCES_DEV=

# E-mails et SMS (Brevo, DPA signé) ; Entra ID du tenant GDS
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Focus Troupeau"
BREVO_CLE_API=
BREVO_SMS_EXPEDITEUR=GDS
SMS_PILOTE=brevo
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/entra/retour"
ENTRA_GROUPES=

# Fichiers privés (bulletins, fiches figées) : volume « fichiers »
FICHES_DISQUE=local

# Sauvegardes (ENF-SEC-07)
SAUVEGARDE_CLE=
SAUVEGARDE_RETENTION_JOURS=30
SAUVEGARDE_DOSSIER=/var/www/html/storage/app/sauvegardes

PHP_FPM_MAX_CHILDREN=20
