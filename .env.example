APP_NAME="Focus Troupeau"
APP_VERSION=0.1.0-dev
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=Europe/Paris

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Docker Compose (docker-compose.yml) ---
HOST_UID=1000
HOST_GID=1000
APP_PORT=8090
DB_FORWARD_PORT=54320
MAILPIT_UI_PORT=8026
VITE_PORT=5174

# --- PostgreSQL 16 + PostGIS 3.4 (service postgres) ---
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=focustroupeau
DB_USERNAME=focustroupeau
DB_PASSWORD=focustroupeau

# --- Redis : sessions, cache, files d'attente (chapitre 6.1) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Production : cookies réservés à HTTPS (ENF-SEC-01)
SESSION_SECURE_COOKIE=false

# En-têtes de sécurité (ENF-SEC-01) : CSP enforce | report | off ; serveur Vite à autoriser en développement
SECURITE_CSP=enforce
SECURITE_HSTS_SECONDES=31536000
SECURITE_CSP_SOURCES_DEV=http://localhost:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=focustroupeau

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- E-mails : Mailpit en développement (http://localhost:8026), Brevo en recette / production ---
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="ne-pas-repondre@focustroupeau.local"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Entra ID du tenant GDS (EF-M0-04) : laisser MICROSOFT_CLIENT_ID vide désactive la connexion Entra ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI="${APP_URL}/auth/entra/retour"
# Groupes Entra → rôle et GDS : "id_groupe:role:gds" séparés par des virgules (gds = 24, 47 ou *), voir config/entra.php
ENTRA_GROUPES=

# --- Lecture AGDS par SAGEMA (EF-M9-03, § 6.4) : vues en lecture seule du schéma « focus » de SAGEMA ---
# Laisser SAGEMA_DB_HOST vide désactive le volet « Données AGDS ». Compte membre du rôle focus_troupeau_lecture.
SAGEMA_DB_HOST=
SAGEMA_DB_PORT=5432
SAGEMA_DB_DATABASE=sagema
SAGEMA_DB_USERNAME=focus_troupeau
SAGEMA_DB_PASSWORD=
SAGEMA_DB_SCHEMA=focus
SAGEMA_DB_TIMEOUT=5

# --- Jeu d'essai J4 (développement uniquement) : mot de passe des comptes *@j4.test ---
J4_MOT_DE_PASSE=

# Fiches PDF (Browsershot, EF-GEN-08) : chemins fournis par l'image Docker ; délai de rendu en secondes
# BROWSERSHOT_CHROME_PATH=/usr/bin/chromium
# BROWSERSHOT_NODE_MODULES=/usr/local/lib/node_modules
FICHES_DELAI_SECONDES=60

# Brevo (EF-M8-05) : e-mails par SMTP (MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587, identifiants SMTP Brevo),
# SMS par l'API ; SMS_PILOTE=brevo en recette et en production, journal en développement
BREVO_CLE_API=
BREVO_SMS_EXPEDITEUR=GDS
SMS_PILOTE=journal

# Sauvegardes chiffrées (ENF-SEC-07) : clé de chiffrement (gestionnaire de secrets, jamais dans le dépôt),
# rétention, dossier lu par la supervision
SAUVEGARDE_CLE=
SAUVEGARDE_RETENTION_JOURS=30
SAUVEGARDE_DOSSIER=/var/www/html/storage/app/sauvegardes
